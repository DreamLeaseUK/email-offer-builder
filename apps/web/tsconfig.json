{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["vite/client"],
    // noUnusedLocals/Parameters are intentionally omitted: the vendored design-system .tsx source
    // imports React unconditionally, which those flags would trip on.
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
