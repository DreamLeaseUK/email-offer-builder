{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offer-mailer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Daily retention/housekeeping (src/retention.ts): purges the 24h lookup cache, and campaign records
  // only if RETENTION_CAMPAIGN_DAYS is set. 03:00 UTC.
  "triggers": { "crons": ["0 3 * * *"] },
  // Static files served before the Worker runs: /a/* email assets now, the web app build later.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "vars": {
    // Cloudflare Access: team domain and the application's AUD tag. Leave empty locally;
    // the middleware then accepts DEV_USER_EMAIL from .dev.vars.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Origin that serves /r, /c, /b, /f and /a. Becomes https://offers.dreamlease.co.uk once the
    // custom domain is attached; until then the workers.dev URL so emails render end to end.
    "PUBLIC_BASE_URL": "https://offer-mailer.matt-wilson-9b8.workers.dev",
    "TOOL_BASE_URL": "https://mailer.dreamlease.co.uk",
    "APP_VERSION": "0.5.0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "offer-mailer",
      "database_id": "32d1b987-b550-4bb4-9bfc-dd219c9404d4",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "offer-mailer-images" },
    { "binding": "HOSTED", "bucket_name": "offer-mailer-hosted" },
    { "binding": "BROCHURES", "bucket_name": "offer-mailer-brochures" }
  ],
  // Cloudflare Images binding (brief §5.3 step 4): resizes the vehicle image to a 1200px JPEG before it
  // goes to R2. Billed per unique transformation; the free allowance covers our volume.
  "images": { "binding": "TRANSFORM" }
  // Secrets (wrangler secret put): FIRECRAWL_API_KEY
}
