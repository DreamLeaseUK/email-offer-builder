{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offer-mailer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Daily retention/housekeeping (src/retention.ts): purges the 24h lookup cache, and campaign records
  // only if RETENTION_CAMPAIGN_DAYS is set. 03:00 UTC.
  "triggers": { "crons": ["0 3 * * *"] },
  // Static files. The /a/* email assets are served straight from ./public on every host. "/" and "/app/*" (the
  // web app, built into ./public/app) go to the Worker first, which serves the app only on the tool host (src/ui.ts).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/", "/app/*"] },
  // Where the Worker answers (decided 28 Sept 2026, docs/architecture.md B3):
  //  - marketingtools.dreamelectric.uk: the tool (web app + /api), a Custom Domain on our dreamelectric.uk zone.
  //    Cloudflare Access protects the whole host.
  //  - offers.dreamlease.co.uk: customer links (hosted pages, /r, /b, /f, /a), a Cloudflare for SaaS custom hostname
  //    on the dreamelectric.uk zone (CNAME at 123-Reg), sent to the Worker by the route offers.dreamlease.co.uk/*.
  //  - workers.dev stays on so links in emails already sent keep working.
  // The Custom Domain and the route are attached ONCE in the dashboard (docs/it-runbook-sign-in.md Part C), NOT
  // listed here: with a "routes" key, `wrangler dev --remote` (pnpm dev:live) previews on the first route's zone
  // instead of workers.dev and stops serving the local code (seen 28 Sept). `wrangler deploy` only publishes routes
  // the file lists, so it leaves the dashboard ones in place (checked in wrangler 4.131's triggersDeploy).
  "workers_dev": true,
  "vars": {
    // Cloudflare Access team domain. The application's AUD tag is NOT a var: it is a production-only secret
    // (wrangler secret put ACCESS_AUD), so wrangler dev and the tests keep the DEV_USER_EMAIL bypass (src/env.ts).
    "ACCESS_TEAM_DOMAIN": "dreamlease.cloudflareaccess.com",
    // Origin that serves /r, /c, /b, /f and /a in emails: the DreamLease address since 6 Oct 2026 (verified live that
    // day: Cloudflare for SaaS hostname and certificate Active). workers.dev stays on, so emails sent before keep working.
    "PUBLIC_BASE_URL": "https://offers.dreamlease.co.uk",
    // The tool's own origin: the only host that serves the web app.
    "TOOL_BASE_URL": "https://marketingtools.dreamelectric.uk",
    "APP_VERSION": "0.7.7",
    // Sending from the salesperson's own mailbox (Phase 1): the Send app of docs/it-runbook-sign-in.md Part D. The two
    // IDs are not secret; IT emails them (D9). Empty = not set up: the tool offers Copy for Outlook only. The client
    // secret and the token-encryption key are secrets (MAIL_CLIENT_SECRET, MAIL_TOKEN_KEY). The return address must
    // match D4 exactly; `pnpm dev` and `pnpm dev:live` override it with the localhost one (apps/api/package.json).
    "MAIL_TENANT_ID": "62c0e616-b19d-4087-ae4a-3cfe43bab437",
    "MAIL_CLIENT_ID": "e4dd2d33-b1ec-4c84-88e1-0b46f8eb3cc6",
    "MAIL_REDIRECT_URI": "https://marketingtools.dreamelectric.uk/api/mail/callback"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "offer-mailer",
      "database_id": "32d1b987-b550-4bb4-9bfc-dd219c9404d4",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "offer-mailer-images" },
    { "binding": "HOSTED", "bucket_name": "offer-mailer-hosted" },
    { "binding": "BROCHURES", "bucket_name": "offer-mailer-brochures" }
  ],
  // Cloudflare Images binding (brief §5.3 step 4): resizes the vehicle image to a 1200px JPEG before it
  // goes to R2. Billed per unique transformation; the free allowance covers our volume.
  "images": { "binding": "TRANSFORM" }
  // Secrets (wrangler secret put): FIRECRAWL_API_KEY, MAIL_CLIENT_SECRET, MAIL_TOKEN_KEY, ACCESS_AUD (production only; set after the first deploy of
  // this file, which removes the old empty ACCESS_AUD var that would otherwise clash with the secret's name)
}
